# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CONTACT_EMAIL: The recipient email address where B2B & customer enquiries will be delivered.
CONTACT_EMAIL="admin@richmindsinternational.com.ng"

# RESEND_API_KEY: Transactional email API key from Resend (https://resend.com) for reliable outbound email delivery.
RESEND_API_KEY=""

# CONTACT_FROM_EMAIL: The verified sender address configured in your Resend account (e.g., enquiries@richminds.co.uk or onboarding@resend.dev for testing).
CONTACT_FROM_EMAIL="onboarding@resend.dev"
